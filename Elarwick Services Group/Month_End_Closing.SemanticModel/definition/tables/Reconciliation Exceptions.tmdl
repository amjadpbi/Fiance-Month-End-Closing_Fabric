	/// Technical composite key for an exception group, matching reconciliation results by run and reference.
	column ReconciliationGroupKey = VAR _Run = COALESCE ( 'Reconciliation Exceptions'[ReconciliationRunID], "" ) VAR _Reference = 'Reconciliation Exceptions'[NormalizedReference] RETURN FORMAT ( LEN ( _Run ), "0" ) & ":" & _Run & ":" & IF ( ISBLANK ( _Reference ), "N", "V" & FORMAT ( LEN ( _Reference ), "0" ) & ":" & _Reference )
		dataType: string
