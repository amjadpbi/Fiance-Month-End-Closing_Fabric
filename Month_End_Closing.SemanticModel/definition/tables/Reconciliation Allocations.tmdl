/// One row per bank-transaction to journal-entry allocation. AllocationRunID differs from the reconciliation result run ID in the current Warehouse snapshot.
table 'Reconciliation Allocations'
	lineageTag: f78270b6-e5d3-4f15-9e01-d583e8f44deb

	/// Counts allocation-level bank transaction to journal entry rows.
	measure 'Allocation Rows' = COUNTROWS ( 'Reconciliation Allocations' )
		formatString: #,##0
		displayFolder: Allocations
		lineageTag: bc5fdda1-cbe2-4530-9c80-438d819b4734

	/// Sums allocation-grain allocated amounts; does not sum repeated bank or ledger group totals.
	measure 'Allocated Signed Amount' = SUM ( 'Reconciliation Allocations'[AllocatedSignedAmount] )
		formatString: $#,##0.00;($#,##0.00);$0.00
		displayFolder: Allocations
		lineageTag: e9d907d7-10ec-4222-9734-2bd69fd5dfaa

	column AllocationRunID
		dataType: string
		isHidden
		lineageTag: e9337a39-c51e-435d-b8b9-ceffbc74fec2
