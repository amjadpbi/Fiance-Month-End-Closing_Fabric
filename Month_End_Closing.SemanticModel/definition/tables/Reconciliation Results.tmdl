/// One row per reconciliation reference group in a reconciliation run. Group-level amounts must not be summed through allocation detail.
table 'Reconciliation Results'
	lineageTag: d3eb7454-b51a-4cea-a0e8-fe58043fe268

	/// Counts reference-group rows in the selected reconciliation result set, including groups with a missing reference.
	measure 'Total Reconciliation Groups' = COUNTROWS ( 'Reconciliation Results' )
		formatString: #,##0
		displayFolder: Reconciliation
		lineageTag: f8aec8e4-d353-48c5-b6a7-9871490ba714

	/// Counts confirmed one-to-one and confirmed grouped reconciliation result rows.
	measure 'Confirmed Reconciliation Groups' = COALESCE ( CALCULATE ( COUNTROWS ( 'Reconciliation Results' ), KEEPFILTERS ( 'Reconciliation Results'[ReconciliationStatus] IN { "CONFIRMED_MATCH", "CONFIRMED_GROUP_MATCH" } ) ), 0 )
		formatString: #,##0
		displayFolder: Reconciliation
		lineageTag: 3b6114b7-5c93-4721-85d5-cfb3e7737a41

	/// Counts reconciliation result rows not marked as a confirmed match or confirmed group match.
	measure 'Groups Requiring Review' = COALESCE ( CALCULATE ( COUNTROWS ( 'Reconciliation Results' ), KEEPFILTERS ( 'Reconciliation Results'[ReconciliationStatus] <> "CONFIRMED_MATCH" ), KEEPFILTERS ( 'Reconciliation Results'[ReconciliationStatus] <> "CONFIRMED_GROUP_MATCH" ) ), 0 )
		formatString: #,##0
		displayFolder: Reconciliation
		lineageTag: aade5527-ab35-4b87-b1ef-90697b1516dc

	/// Confirmed reconciliation groups divided by all reconciliation result groups in the current filter context.
	measure 'Group Match Rate' = DIVIDE ( [Confirmed Reconciliation Groups], [Total Reconciliation Groups] )
		formatString: 0.0%
		displayFolder: Reconciliation
		lineageTag: a486f6aa-e989-425c-b45b-76ad20a3436f

	/// Sums bank-side signed amounts once per reconciliation result group. Blank amounts for groups without bank data remain blank at row level.
	measure 'Bank Signed Total' = SUM ( 'Reconciliation Results'[BankSignedAmount] )
		formatString: $#,##0.00;($#,##0.00);$0.00
		displayFolder: Amounts
		lineageTag: e69f1341-f353-4bcd-a610-cb0af21c4ec0

	/// Sums ledger-side signed amounts once per reconciliation result group. Blank amounts for groups without ledger data remain blank at row level.
	measure 'Ledger Signed Total' = SUM ( 'Reconciliation Results'[GLSignedAmount] )
		formatString: $#,##0.00;($#,##0.00);$0.00
		displayFolder: Amounts
		lineageTag: 1cf0a493-d048-40cd-89ad-8f12947db2e3

	/// Net signed sum of nonblank group amount differences; bank-only and ledger-only blank differences are not coerced to zero.
	measure 'Reconciliation Amount Difference' = SUM ( 'Reconciliation Results'[Amount Difference] )
		formatString: $#,##0.00;($#,##0.00);$0.00
		displayFolder: Amounts
		lineageTag: e6f2e872-b627-42e7-958f-04f552b019a3

