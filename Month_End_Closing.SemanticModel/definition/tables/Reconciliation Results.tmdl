	/// Technical composite key for a reconciliation group using run ID and reference, with explicit handling for missing references.
	column ReconciliationGroupKey = VAR _Run = COALESCE ( 'Reconciliation Results'[ReconciliationRunID], "" ) VAR _Reference = 'Reconciliation Results'[NormalizedReference] RETURN FORMAT ( LEN ( _Run ), "0" ) & ":" & _Run & ":" & IF ( ISBLANK ( _Reference ), "N", "V" & FORMAT ( LEN ( _Reference ), "0" ) & ":" & _Reference )
		dataType: string
		isHidden
		lineageTag: 793204b9-ee38-49a1-be5c-830be36d4d68

